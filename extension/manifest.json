{
  "manifest_version": 3,
  "name": "PageProof",
  "version": "3.12.1",
  "description": "Capture a whole web page as evidence, reverse search many pictures at once, inspect the hidden data inside a picture, or convert and open files. Saved as PDF and evidence packs with fingerprints and timestamps.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "PageProof",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "webRequest",
    "downloads",
    "contextMenus",
    "clipboardWrite",
    "tabGroups",
    "alarms",
    "notifications"
  ],
  "commands": {
    "capture-page": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "Capture the whole page straight away"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "pageproof@thebenpsych",
      "strict_min_version": "121.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "rclick.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "*://*.google.com/*",
        "*://*.google.co.uk/*",
        "*://*.google.ca/*",
        "*://*.google.com.au/*",
        "*://*.google.de/*",
        "*://*.google.fr/*",
        "*://yandex.com/*",
        "*://*.yandex.com/*",
        "*://yandex.ru/*",
        "*://*.yandex.ru/*",
        "*://www.bing.com/*"
      ],
      "js": [
        "rsearch.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
