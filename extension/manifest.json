{
  "manifest_version": 3,
  "name": "PageProof",
  "version": "3.2.1",
  "description": "Capture a whole web page as evidence: stamped with its web address and time, saved as PDF and a full HTML backup with images.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "PageProof: capture this whole page",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "db.js",
      "background.js"
    ]
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "webRequest",
    "downloads",
    "contextMenus",
    "clipboardWrite"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "Capture the whole page"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "pageproof@thebenpsych",
      "strict_min_version": "121.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "host_permissions": [
    "<all_urls>"
  ]
}
