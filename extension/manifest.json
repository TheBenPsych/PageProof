{
  "manifest_version": 3,
  "name": "PageProof",
  "version": "3.3.1",
  "description": "Capture a whole web page as evidence, or inspect the hidden data inside a picture. Saved as PDF and evidence packs with fingerprints and timestamps.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "PageProof",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "db.js",
      "background.js"
    ]
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "webRequest",
    "downloads",
    "contextMenus",
    "clipboardWrite"
  ],
  "commands": {
    "capture-page": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "Capture the whole page straight away"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "pageproof@thebenpsych",
      "strict_min_version": "121.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "host_permissions": [
    "<all_urls>"
  ]
}
